{
  "name": "discordjs-test-kit",
  "version": "0.5.0",
  "description": "A fake Discord (REST + Gateway) that discord.js bots connect to in tests",
  "keywords": [
    "discord",
    "discord.js",
    "fake",
    "mock",
    "test",
    "testing",
    "vitest"
  ],
  "homepage": "https://github.com/veksen-enterprises/discordjs-test-kit#readme",
  "bugs": {
    "url": "https://github.com/veksen-enterprises/discordjs-test-kit/issues"
  },
  "license": "MIT",
  "author": "Jean-Philippe Sirois",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veksen-enterprises/discordjs-test-kit.git"
  },
  "files": [
    "dist",
    "skills",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "vitest run",
    "coverage:api": "node scripts/api-coverage/run.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test:contract": "vitest run contract"
  },
  "dependencies": {
    "discord-api-types": "^0.38.59",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@discordjs/voice": "^0.19.2",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "discord.js": "^14.28.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "discord.js": "^14.26.4",
    "vitest": "^4.1.2 || ^5.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
